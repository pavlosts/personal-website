---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { loadTimeline, type Branch, type Entry } from '../../lib/timeline';
import { fullDate, monthYear } from '../../lib/site';

export async function getStaticPaths() {
  const { branches, entries } = await loadTimeline();
  return entries
    .filter((e) => e.hasBody)
    .map((entry) => ({
      params: { slug: entry.slug },
      props: {
        entry,
        branch: branches.find((b) => b.id === entry.branchId)!,
        also: entry.also.map((id) => branches.find((b) => b.id === id)).filter((b): b is Branch => !!b),
      },
    }));
}

interface Props { entry: Entry; branch: Branch; also: Branch[] }
const { entry, branch, also } = Astro.props;
const { Content } = await render(entry.raw);
const others = [...branch.entries].reverse();
---

<Base title={`${entry.title} · Pavlos`}>
  <article class="note" style={`--c:${branch.color}`}>
    <a class="back" href="/">
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M8.5 3 4.5 7l4 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
      Back to the tree
    </a>
    <div class="meta">
      <span class:list={['pill', { dead: branch.ended }]}><i style={`background:${branch.color}`}></i>{branch.name}{branch.ended && <small>ended {monthYear(branch.ended)}</small>}</span>
      {also.map((b) => (
        <span class:list={['pill', 'also', { dead: b.ended }]}><i style={`background:${b.color}`}></i>{b.name}</span>
      ))}
      <time datetime={entry.date.toISOString()}>{fullDate(entry.date)}</time>
      {entry.kind && <em>{entry.kind === 'start' ? 'started' : 'ended'}</em>}
    </div>
    <h1>{entry.title}</h1>
    <div class="prose"><Content /></div>
  </article>

  {others.length > 1 && (
    <aside class="branch-line" style={`--c:${branch.color}`}>
      <h2>On this branch</h2>
      <ol>
        {others.map((e) => {
          const here = e.slug === entry.slug;
          const Tag = e.hasBody && !here ? 'a' : 'div';
          return (
            <li class:list={{ here }}>
              <Tag href={e.hasBody && !here ? `/notes/${e.slug}` : undefined}>
                <span class="d">{monthYear(e.date)}</span>
                <span class="t">{e.title}</span>
              </Tag>
            </li>
          );
        })}
      </ol>
    </aside>
  )}
</Base>

<style>
  .note { max-width: 680px; margin: 0 auto; padding: 140px 24px 0; }
  .back { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--muted); transition: color .2s; }
  .back:hover { color: var(--ink); }
  .meta { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 40px; font: 500 12px var(--mono); color: var(--muted); }
  .meta .pill { font-family: Geist, sans-serif; font-size: 12.5px; color: var(--ink); }
  .meta .pill.dead { color: var(--muted); }
  .meta .pill.also { margin-left: -6px; background: transparent; }
  .meta em { font-style: normal; font-size: 10.5px; padding: 2px 7px; border-radius: 4px; background: rgba(25, 24, 22, .05); color: var(--ink2); }
  h1 { font-weight: 600; font-size: 48px; line-height: 1.05; letter-spacing: -.04em; margin-top: 20px; text-wrap: balance; }

  .prose { margin-top: 36px; font-size: 17px; line-height: 1.7; color: #2E2C28; letter-spacing: -.008em; }
  .prose :global(> * + *) { margin-top: 1.1em; }
  .prose :global(h2) { font-size: 24px; font-weight: 600; letter-spacing: -.025em; line-height: 1.25; margin-top: 2em; color: var(--ink); }
  .prose :global(h3) { font-size: 19px; font-weight: 600; letter-spacing: -.015em; margin-top: 1.8em; color: var(--ink); }
  .prose :global(a) { text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--c) 55%, transparent); text-underline-offset: 3px; text-decoration-thickness: 1.5px; }
  .prose :global(a:hover) { text-decoration-color: var(--c); }
  .prose :global(strong) { font-weight: 600; color: var(--ink); }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3em; }
  .prose :global(li + li) { margin-top: .4em; }
  .prose :global(li::marker) { color: var(--soft); }
  .prose :global(blockquote) { border-left: 2px solid var(--c); padding: 2px 0 2px 20px; color: var(--ink2); }
  .prose :global(img) { display: block; max-width: 100%; height: auto; border-radius: 14px; margin: 2em 0; box-shadow: 0 18px 40px -24px rgba(25, 24, 22, .35); }
  .prose :global(code) { font: 500 .85em var(--mono); background: rgba(25, 24, 22, .05); padding: 2px 6px; border-radius: 5px; }
  .prose :global(pre) { background: #1D1C1A; color: #EDEAE3; padding: 18px 20px; border-radius: 12px; overflow-x: auto; font-size: 13.5px; line-height: 1.6; }
  .prose :global(pre code) { background: none; padding: 0; color: inherit; }
  .prose :global(hr) { border: 0; height: 1px; background: var(--line); margin: 2.4em 0; }

  .branch-line { max-width: 680px; margin: 80px auto 0; padding: 32px 24px 0; border-top: 1px solid var(--line); }
  .branch-line h2 { font: 500 12px var(--mono); color: var(--muted); font-weight: 500; }
  .branch-line ol { list-style: none; margin-top: 18px; position: relative; }
  .branch-line ol::before { content: ""; position: absolute; left: 4px; top: 8px; bottom: 8px; width: 1.5px; background: var(--c); opacity: .35; }
  .branch-line li > * { display: grid; grid-template-columns: 76px 1fr; gap: 12px; padding: 7px 0 7px 26px; position: relative; font-size: 14px; }
  .branch-line li > *::before { content: ""; position: absolute; left: 0; top: 12px; width: 9px; height: 9px; border-radius: 50%; background: var(--bg); border: 1.5px solid var(--c); }
  .branch-line li.here > *::before { background: var(--c); }
  .branch-line .d { font: 500 11.5px var(--mono); color: var(--muted); padding-top: 2px; }
  .branch-line li.here .t { font-weight: 600; }
  .branch-line a .t { text-decoration: underline; text-decoration-color: rgba(25, 24, 22, .2); text-underline-offset: 3px; }
  .branch-line a:hover .t { text-decoration-color: var(--ink); }

  @media (max-width: 760px) {
    .note { padding-top: 110px; }
    h1 { font-size: 36px; }
    .prose { font-size: 16.5px; }
  }
</style>

<script is:inline define:vars={{
  noteSlug: entry.slug,
  noteTitle: entry.title,
  branchId: branch.id,
  branchName: branch.name,
  noteKind: entry.kind ?? null,
}}>
  window.posthog?.capture('note_viewed', {
    slug: noteSlug,
    title: noteTitle,
    branch_id: branchId,
    branch_name: branchName,
    kind: noteKind,
  });

  document.querySelector('.back')?.addEventListener('click', () => {
    window.posthog?.capture('back_to_tree_clicked', {
      from_slug: noteSlug,
      branch_id: branchId,
    });
  });

  document.querySelector('.prose')?.addEventListener('click', (event) => {
    const link = event.target.closest('a');
    if (!link) return;
    const href = link.getAttribute('href') || '';
    if (!href || href.startsWith('/') || href.startsWith('#')) return;
    window.posthog?.capture('note_external_link_clicked', {
      slug: noteSlug,
      href,
      text: link.textContent?.trim(),
    });
  });

  document.querySelector('.branch-line')?.addEventListener('click', (event) => {
    const link = event.target.closest('a');
    if (!link) return;
    window.posthog?.capture('branch_note_clicked', {
      from_slug: noteSlug,
      to_slug: link.getAttribute('href')?.split('/').pop(),
      branch_id: branchId,
    });
  });
</script>
