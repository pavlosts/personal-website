---
import Base from '../layouts/Base.astro';
import { loadTimeline } from '../lib/timeline';
import { CATEGORIES, ROOTS, iso, monthYear } from '../lib/site';

const { branches, entries } = await loadTimeline();
const empty = entries.length === 0;

const byYear = new Map<number, typeof entries>();
for (const e of entries) {
  const y = e.date.getUTCFullYear();
  byYear.set(y, [...(byYear.get(y) ?? []), e]);
}
const branchOf = (id: string) => branches.find((b) => b.id === id)!;

const data = {
  roots: ROOTS,
  colors: Object.fromEntries(Object.entries(CATEGORIES).map(([k, v]) => [k, v.color])),
  branches: branches.map((b) => ({
    id: b.id,
    name: b.name,
    category: b.category,
    ended: b.ended ? iso(b.ended) : null,
    from: b.from ?? null,
  })),
  entries: entries.map((e) => ({
    slug: e.slug,
    title: e.title,
    date: iso(e.date),
    branch: e.branchId,
    also: e.also.filter((id) => branches.some((b) => b.id === id)),
    kind: e.kind,
    link: e.hasBody,
  })),
};
---

<Base nav="growth">
  <section class="intro">
    <h1>Hi! 👋 I am Pavlos, <span>and this is my journey</span></h1>
    <p class="lead">As a creative person with ADHD, I can't stop experimenting with multiple things. I created this place to share about them without a filter. Enjoy!</p>
  </section>
  <div class="intro-rule" aria-hidden="true"></div>

  {empty ? (
    <div class="sprout" aria-hidden="true">
      <svg viewBox="0 0 240 260" width="240" height="260">
        <defs>
          <linearGradient id="sp" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0" stop-color="#191816" stop-opacity=".1" />
            <stop offset=".4" stop-color="#191816" stop-opacity=".85" />
            <stop offset="1" stop-color="#191816" />
          </linearGradient>
        </defs>
        <path d="M118.4,210 C118.8,150 119.4,90 119.5,60 L120.5,60 C120.6,90 121.2,150 121.6,210 Z" fill="url(#sp)" />
        <line x1="120" y1="58" x2="120" y2="30" stroke="#2F6B5A" stroke-width="2" stroke-linecap="round" class="flow" opacity=".7" />
        <circle cx="120" cy="26" r="14" fill="#2F6B5A" opacity=".16" class="halo" />
        <circle cx="120" cy="26" r="4.5" fill="#2F6B5A" />
        <circle cx="120" cy="26" r="1.6" fill="#fff" />
        {[[-1, 60, 30], [1, 70, 24], [-1, 30, 44], [1, 34, 40]].map(([d, w, h], i) => (
          <path d={`M120,202 C${120 + d * w * .25},${210 + h * .35} ${120 + d * w * .7},${210 + h * .55} ${120 + d * w},${210 + h}`} stroke="#191816" stroke-opacity={.2 - i * .03} stroke-width="1.2" fill="none" stroke-linecap="round" />
        ))}
      </svg>
    </div>
  ) : (
    <>
      <div class="wrap" id="wrap"><div class="stage" id="stage"><svg id="svg"></svg></div></div>
      <div class="viewing" id="viewing"><div class="prog"><i id="prog"></i></div><div><small>Viewing</small><b id="yr"></b></div></div>

      <section class="feed" aria-hidden="true">
        {[...byYear.entries()].map(([year, list]) => (
          <div class="fy">
            <h2>{year}</h2>
            <ol>
              {list.map((e) => {
                const b = branchOf(e.branchId);
                const Tag = e.hasBody ? 'a' : 'div';
                return (
                  <li>
                    <Tag class:list={['fi', { dead: b.ended }]} href={e.hasBody ? `/notes/${e.slug}` : undefined}>
                      <i style={`background:${b.color}`}></i>
                      <span class="d">{monthYear(e.date)} · {b.name}{e.kind && <em>{e.kind === 'start' ? 'started' : 'ended'}</em>}</span>
                      <span class="t">{e.title}</span>
                      {e.also.length > 0 && (
                        <span class="also">
                          {e.also.filter((id) => branches.some((x) => x.id === id)).map((id) => (
                            <span><i style={`background:${branchOf(id).color}`}></i>{branchOf(id).name}</span>
                          ))}
                        </span>
                      )}
                    </Tag>
                  </li>
                );
              })}
            </ol>
          </div>
        ))}
        {ROOTS.length > 0 && (
          <div class="fy roots">
            <h2><a href="/about">About me</a></h2>
            <ul>{ROOTS.map((r) => <li><b>{r.name}</b>{r.note && <span>{r.note}</span>}</li>)}</ul>
          </div>
        )}
      </section>

      <script type="application/json" id="tree-data" set:html={JSON.stringify(data)} />
    </>
  )}
</Base>

<style is:global>
  .intro { max-width: 760px; margin: 0 auto; padding: 150px 24px 0; text-align: center; }
  .intro h1 { font-weight: 600; font-size: 68px; line-height: 1; letter-spacing: -.045em; margin-top: 24px; text-wrap: balance; }
  .intro h1 span { color: var(--soft); }
  .lead { margin: 22px auto 0; max-width: 560px; color: var(--ink2); font-size: 16.5px; line-height: 1.6; text-wrap: pretty; }
  .intro-rule { width: 48px; height: 1px; margin: 44px auto 0; background: rgba(25, 24, 22, .14); }

  .sprout { display: flex; justify-content: center; margin: 56px 0 40px; }

  .wrap { position: relative; margin-top: 36px; }
  .stage { position: relative; width: 1200px; margin: 0 auto; transform-origin: top center; }
  .stage svg { position: absolute; left: 0; top: 0; overflow: visible; }
  .yr { font: 500 12px var(--mono); fill: #ABA69C; }
  .br path.stem { transition: stroke-dashoffset 1.8s cubic-bezier(.45, .05, .2, 1); }
  .br .fade { opacity: 0; transition: opacity .6s ease .9s; }
  .br.in .fade { opacity: 1; }
  .ev { opacity: 0; transform: translateY(6px); transition: opacity .6s ease, transform .6s ease; }
  .ev.in { opacity: 1; transform: none; }
  .dimming .br:not(.hl), .dimming .ev:not(.hl), .dimming .tag:not(.hl) { opacity: .12 !important; }
  .halo { animation: halo 2.6s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes halo { 50% { transform: scale(1.5); opacity: .35; } }
  .flow { stroke-dasharray: 2 5; animation: flow 1s linear infinite; }
  @keyframes flow { to { stroke-dashoffset: -7; } }
  .leaf { transform-box: view-box; animation: sway 7s ease-in-out infinite; }
  @keyframes sway { 50% { transform: rotate(6deg); } }

  .ev { position: absolute; width: 176px; cursor: default; }
  a.ev { cursor: pointer; }
  .ev.r { text-align: right; }
  .ev.start { display: flex; flex-direction: column-reverse; }
  .ev .d, .fi .d { font: 500 11px var(--mono); color: var(--muted); display: flex; gap: 6px; align-items: center; }
  .ev.r .d { justify-content: flex-end; }
  .ev .d em, .fi .d em { font-style: normal; font-size: 10px; padding: 1px 6px; border-radius: 4px; background: rgba(25, 24, 22, .05); color: var(--ink2); letter-spacing: .02em; }
  .ev .t { font-size: 14px; font-weight: 500; line-height: 1.35; margin-top: 2px; letter-spacing: -.01em; text-wrap: pretty; }
  .ev.start .t { margin-top: 0; margin-bottom: 2px; }
  .ev.dead .t { color: var(--muted); font-weight: 400; }
  .also { display: flex; flex-wrap: wrap; gap: 4px 10px; margin-top: 4px; font-size: 11.5px; color: var(--muted); }
  .ev.start .also { margin-top: 0; margin-bottom: 4px; }
  .also > span { display: inline-flex; align-items: center; gap: 5px; }
  .also > span::before { content: "+"; font: 500 11px var(--mono); color: var(--soft); margin-right: -1px; }
  .also i { width: 6px; height: 6px; border-radius: 50%; }
  .ev.r .also { justify-content: flex-end; }
  .bridge { opacity: 0; transition: opacity .6s ease; }
  .bridge.in { opacity: 1; }
  .bridge path { stroke-dasharray: 1.5 4; opacity: 0; transition: opacity .25s; }
  .bridge.hl path { opacity: 1; }
  .bridge .echo { cursor: pointer; }
  .dimming .bridge.in:not(.hl) { opacity: .12 !important; }
  a.ev:hover .t, a.fi:hover .t { text-decoration: underline; text-decoration-color: rgba(25, 24, 22, .25); text-underline-offset: 3px; }
  .tag { position: absolute; transform: translate(-50%, -100%); display: flex; align-items: center; gap: 7px; white-space: nowrap; padding: 5px 10px; border-radius: 999px; font-size: 12px; font-weight: 500; background: var(--card); border: 1px solid var(--line); box-shadow: 0 4px 14px -6px rgba(25, 24, 22, .2); transition: opacity .25s; }
  .tag i { width: 7px; height: 7px; border-radius: 50%; }
  .tag small { font: 500 10.5px var(--mono); color: var(--muted); }
  .tag.dead { background: var(--bg); box-shadow: none; color: var(--muted); }
  .tag.me { background: var(--ink); color: #fff; border-color: var(--ink); }
  .today { position: absolute; left: 0; transform: translateY(-50%); font: 500 11px var(--mono); color: #fff; background: var(--ink); padding: 3px 9px; border-radius: 999px; }
  .root-name { font: 500 13px Geist, sans-serif; fill: var(--ink); letter-spacing: -.01em; }
  .root-note { font: 500 10.5px var(--mono); fill: var(--muted); }

  .viewing { position: fixed; left: 24px; bottom: 24px; z-index: 40; display: flex; align-items: center; gap: 12px; padding: 10px 14px; border-radius: 14px; background: rgba(255, 255, 255, .78); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border: 1px solid var(--line); box-shadow: 0 10px 30px -14px rgba(25, 24, 22, .3); opacity: 0; transition: opacity .4s; }
  .viewing.on { opacity: 1; }
  .viewing b { font-size: 22px; font-weight: 600; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
  .viewing small { display: block; font: 500 11px var(--mono); color: var(--muted); }
  .prog { width: 4px; height: 36px; border-radius: 2px; background: rgba(25, 24, 22, .08); overflow: hidden; }
  .prog i { display: block; width: 100%; background: var(--ink); border-radius: 2px; }

  .feed { display: none; }

  /* Option A: phone-native narrow trunk */
  @media (max-width: 760px) {
    .intro { padding-top: 120px; }
    .intro h1 { font-size: 36px; }
    .lead { font-size: 15px; }
    .intro-rule { margin-top: 28px; }
    .wrap {
      margin-top: 12px;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-x: contain;
      scrollbar-width: thin;
    }
    .stage { margin: 0; }
    .ev { width: 118px; }
    .ev .t { font-size: 12.5px; line-height: 1.3; }
    .ev .d { font-size: 10px; gap: 4px; }
    .ev .d em { font-size: 9px; padding: 1px 5px; }
    .also { font-size: 10.5px; gap: 3px 8px; margin-top: 3px; }
    .tag { font-size: 11px; padding: 4px 8px; gap: 5px; }
    .tag small { font-size: 9.5px; }
    .today { transform: translate(-100%, -50%); }
    .viewing { left: 16px; bottom: max(16px, env(safe-area-inset-bottom)); padding: 8px 12px; gap: 10px; }
    .viewing b { font-size: 18px; }
    .yr { font-size: 10px; }
    .feed { display: none !important; }
  }
</style>

<script is:inline>
(() => {
  const el = document.getElementById('tree-data');
  if (!el) return;
  const DATA = JSON.parse(el.textContent);
  const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const yearOf = (s) => { const [y, m, d] = s.split('-').map(Number); return y + (m - 1) / 12 + (d - 1) / 365; };
  const fmt = (s) => { const [y, m] = s.split('-'); return `${MON[+m - 1]} ${y}`; };
  const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const today = new Date();
  const NOW = today.getFullYear() + today.getMonth() / 12 + (today.getDate() - 1) / 365;

  // Option A on phones: narrow trunk that mostly fits the screen.
  // Cards sit outside the branches. Pan horizontally only if it still overflows; trunk stays centred.
  const MOBILE = innerWidth <= 760;
  const DEAD = '#C9C3B8';
  const EV_W = MOBILE ? 118 : 176;
  const GAP = MOBILE ? 10 : 24;
  // Lane separation on each side ≈ card width so outside cards do not overlap.
  // Stage will be wider than most phones; pan keeps the trunk centred.
  const LANES = MOBILE ? [-168, 168, -56, 56] : [-430, 430, -215, 215];
  const PX = MOBILE ? 260 : 400;
  const TOP = MOBILE ? 72 : 140;
  const RISE = MOBILE ? 88 : 170;
  const laneMax = Math.max(...LANES.map((n) => Math.abs(n)));
  const W = MOBILE ? Math.ceil((laneMax + GAP + EV_W + 16) * 2) : 1200;
  const CX = W / 2;
  if (MOBILE) document.body.classList.add('narrow-tree');

  const events = DATA.entries.map((e) => ({ ...e, y: Math.min(NOW, yearOf(e.date)) }));
  const branches = DATA.branches.map((b, i) => {
    const ev = events.filter((e) => e.branch === b.id).sort((a, c) => a.y - c.y);
    return { ...b, ev, ys: ev[0].y, ye: b.ended ? Math.min(NOW, yearOf(b.ended)) : null, seed: 1 + i * 1.37, col: DATA.colors[b.category] };
  }).sort((a, c) => a.ys - c.ys);
  const byId = Object.fromEntries(branches.map((b) => [b.id, b]));
  branches.forEach((b) => {
    const p = byId[b.from];
    b.parent = p && p.ys <= b.ys && (p.ye == null || p.ye >= b.ys) ? p : null;
    if (b.parent && !b.ye) b.root = b.parent.ye ? DEAD : b.parent.col;
  });

  const FORK = RISE / PX;
  const alive = (o, t) => o.ys <= t && (o.ye == null || o.ye >= t - FORK);
  const originOf = (b, placed) => (b.parent ? placed[branches.indexOf(b.parent)].off : 0);
  const crossCost = (b, off, placed) => {
    const o0 = originOf(b, placed), lo = Math.min(o0, off), hi = Math.max(o0, off);
    const cross = placed.reduce((sum, o) => (o.off > lo && o.off < hi && alive(o, b.ys) ? sum + (o.ye == null ? 2 : 1) : sum), 0);
    const trunk = b.parent && Math.sign(o0) !== Math.sign(off) ? 3 : 0;
    return cross + trunk + (b.parent ? Math.abs(off - o0) / 2000 : 0);
  };
  let best = { cost: Infinity, offs: null }, budget = 20000;
  const search = (i, placed, cost) => {
    if (cost >= best.cost || budget-- < 0) return;
    if (i === branches.length) { best = { cost, offs: placed.map((p) => p.off) }; return; }
    const b = branches[i];
    const busy = (off, gap) => placed.some((o) => o.off === off && (o.ye == null || o.ye > b.ys - gap));
    let options = LANES.filter((off) => !busy(off, 0.2));
    if (!options.length) options = LANES;
    options.forEach((off, rank) => {
      const clash = busy(off, 0.2) ? 10 : busy(off, 0.6) ? 1.5 : 0;
      search(i + 1, [...placed, { off, ys: b.ys, ye: b.ye }], cost + crossCost(b, off, placed) + clash + rank * 0.01);
    });
  };
  search(0, [], 0);
  branches.forEach((b, i) => { b.off = best.offs ? best.offs[i] : LANES[i % 4]; });

  const START = branches[0].ys - 0.35, H = TOP + (NOW - START) * PX + (MOBILE ? 320 : 440);
  const firstYear = Math.floor(branches[0].ys), nowYear = Math.floor(NOW);
  const Y = (t) => TOP + (NOW - t) * PX;
  const stage = document.getElementById('stage'), svg = document.getElementById('svg'), wrap = document.getElementById('wrap');
  stage.style.height = H + 'px';
  stage.style.width = W + 'px';
  svg.setAttribute('width', W); svg.setAttribute('height', H);
  const bx = (b) => CX + b.off;
  const forkY = (b) => Y(b.ys) + RISE;
  const xAt = (b, y) => { const top = forkY(b) - RISE, k = Math.max(0, Math.min(1, (top - y) / 120)); return bx(b) + k * 4 * Math.sin(y / 150 + b.seed); };

  let s = `<defs><linearGradient id="trunk" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#191816" stop-opacity=".8"/><stop offset=".25" stop-color="#191816" stop-opacity=".92"/><stop offset="1" stop-color="#191816"/></linearGradient>`;
  branches.forEach((b) => { if (!b.ye) s += `<linearGradient id="g-${b.id}" gradientUnits="userSpaceOnUse" x1="0" y1="${forkY(b)}" x2="0" y2="${forkY(b) - RISE * 1.6}"><stop offset="0" stop-color="${b.root || '#191816'}" stop-opacity="${b.root ? 1 : .8}"/><stop offset="1" stop-color="${b.col}"/></linearGradient>`; });
  s += `</defs>`;

  for (let yr = Math.ceil(START); yr <= nowYear; yr++) {
    const y = Y(yr);
    s += `<line x1="0" x2="${W}" y1="${y}" y2="${y}" stroke="rgba(25,24,22,.06)"/><text class="yr" x="${MOBILE ? 8 : 0}" y="${y - 10}">${yr}</text>`;
  }
  s += `<line x1="0" x2="${W}" y1="${Y(NOW)}" y2="${Y(NOW)}" stroke="rgba(25,24,22,.18)" stroke-dasharray="3 5"/>`;

  const yRoot = Y(START) + 40, yTip = Y(NOW) - 44;
  const trunkHalf = MOBILE ? 2.4 : 3.6;
  s += `<path d="M${CX - trunkHalf},${yRoot} C${CX - trunkHalf * .85},${yRoot - 600} ${CX - 1.2},${yTip + 500} ${CX - 1},${yTip} L${CX + 1},${yTip} C${CX + 1.2},${yTip + 500} ${CX + trunkHalf * .85},${yRoot - 600} ${CX + trunkHalf},${yRoot} Z" fill="url(#trunk)"/>`;
  s += `<circle cx="${CX}" cy="${yTip - 4}" r="3.2" fill="#191816"/>`;
  const roots = DATA.roots || [], rootTop = yRoot - 6, nr = roots.length;
  const span = Math.min(MOBILE ? 110 : 330, (MOBILE ? 34 : 75) * Math.max(0, nr - 1));
  const slots = roots.map((_, i) => (nr > 1 ? -span + i * (2 * span) / (nr - 1) : 0)).sort((a, c) => Math.abs(a) - Math.abs(c) || a - c);
  roots.forEach((r, i) => {
    const x2 = CX + slots[i], y2 = rootTop + (MOBILE ? 56 : 80) + (1 - i / Math.max(1, nr)) * (MOBILE ? 100 : 150);
    const w = i === 0 ? 1.6 : 1.25, op = (.62 - i * (.24 / Math.max(1, nr - 1))).toFixed(2);
    s += `<path d="M${CX},${rootTop} C${CX + (x2 - CX) * .08},${rootTop + 48} ${x2},${y2 - 70} ${x2},${y2}" fill="none" stroke="#191816" stroke-opacity="${op}" stroke-width="${w}" stroke-linecap="round"/>`
      + `<circle cx="${x2}" cy="${y2}" r="7" fill="var(--bg)"/><circle cx="${x2}" cy="${y2}" r="3.5" fill="#191816" fill-opacity="${Math.min(1, +op + .3)}"/>`
      + `<text class="root-name" x="${x2}" y="${y2 + 22}" text-anchor="middle">${esc(r.name)}</text>`
      + (r.note ? `<text class="root-note" x="${x2}" y="${y2 + 36}" text-anchor="middle">${esc(r.note)}</text>` : '');
  });
  s += `<circle cx="${CX}" cy="${rootTop}" r="7" fill="var(--bg)"/><circle cx="${CX}" cy="${rootTop}" r="4" fill="#191816"/>`;

  const evs = [], tags = [];
  branches.forEach((b) => {
    const side = Math.sign(b.off), dead = !!b.ye, X = bx(b), fy = forkY(b), top = fy - RISE, yE = dead ? Y(b.ye) : Y(NOW);
    const f0 = b.parent ? Math.min(fy, Y(b.parent.ys) - 6) : fy, x0 = b.parent ? xAt(b.parent, f0) : CX, rise = f0 - top;
    let d = `M${x0},${f0} C${x0},${f0 - rise * .55} ${X},${f0 - rise * .5} ${X},${top}`;
    for (let y = top - 10; y >= yE; y -= 10) d += ` L${xAt(b, y).toFixed(1)},${y.toFixed(1)}`;
    d += ` L${xAt(b, yE).toFixed(1)},${yE}`;
    let g = `<g class="br" data-b="${b.id}" data-top="${yE}"><path class="stem" d="${d}" fill="none" stroke="${dead ? DEAD : `url(#g-${b.id})`}" stroke-width="${dead ? 1.5 : (MOBILE ? 2 : 2.2)}" stroke-linecap="round"/><g class="fade">`;
    const xt = xAt(b, yE);
    if (!dead) {
      let k = 0;
      for (let y = yE + 34; y < top - 16; y += 58, k++) {
        const x = xAt(b, y), dd = k % 2 ? 1 : -1;
        g += `<path class="leaf" style="transform-origin:${x}px ${y}px;animation-delay:${-k * .9}s" d="M${x},${y} c${dd * 4},-6 ${dd * 11},-8 ${dd * 16},-5 c${-dd * 4},5 ${-dd * 10},7 ${-dd * 16},5Z" fill="${b.col}" fill-opacity=".13" stroke="${b.col}" stroke-opacity=".55" stroke-width=".8"/>`;
      }
      g += `<line x1="${xt}" y1="${yE}" x2="${xt}" y2="${yE - 30}" stroke="${b.col}" stroke-width="2" stroke-linecap="round" class="flow" opacity=".7"/>`
        + `<circle cx="${xt}" cy="${yE - 34}" r="14" fill="${b.col}" opacity=".16" class="halo"/><circle cx="${xt}" cy="${yE - 34}" r="4.5" fill="${b.col}"/><circle cx="${xt}" cy="${yE - 34}" r="1.6" fill="#fff"/>`;
      tags.push({ b, x: xt, y: yE - 52, html: `<i style="background:${b.col}"></i>${esc(b.name)}` });
    } else {
      g += `<line x1="${xt - 6}" y1="${yE - 8}" x2="${xt + 6}" y2="${yE - 8}" stroke="${DEAD}" stroke-width="1.5" stroke-linecap="round"/>`;
      tags.push({ b, x: xt, y: yE - 18, dead: true, html: `<i style="background:${DEAD}"></i>${esc(b.name)}<small>ended ${fmt(b.ended)}</small>` });
    }
    b.ev.forEach((e) => {
      const y = Y(e.y), x = xAt(b, y), c = dead ? DEAD : b.col;
      g += e.kind === 'start'
        ? `<circle cx="${x}" cy="${y}" r="5" fill="var(--bg)" stroke="${c}" stroke-width="2"/>`
        : `<circle cx="${x}" cy="${y}" r="6.5" fill="var(--bg)"/><circle cx="${x}" cy="${y}" r="${e.kind === 'end' ? 3.5 : 4}" fill="${c}"/>`;
      evs.push({ e, b, x, y, side, dead });
    });
    s += g + `</g></g>`;
  });

  const bridges = [];
  evs.forEach(({ e, b: A, x: xa, y }) => {
    (e.also || []).forEach((id) => {
      const B = byId[id];
      if (!B || B === A || B.ys > e.y || (B.ye != null && B.ye < e.y)) return;
      const xb = xAt(B, y), dx = xb - xa, lift = Math.max(26, Math.min(46, Math.abs(dx) * .14)), cb = B.ye ? DEAD : B.col, ca = A.ye ? DEAD : A.col;
      const gid = `bg-${bridges.length}`;
      bridges.push(y);
      s += `<g class="bridge" data-b="${A.id} ${B.id}" data-e="${e.slug}" data-y="${y}"><defs><linearGradient id="${gid}" gradientUnits="userSpaceOnUse" x1="${xa}" y1="0" x2="${xb}" y2="0"><stop offset="0" stop-color="${ca}"/><stop offset="1" stop-color="${cb}"/></linearGradient></defs>`
        + `<path d="M${xa + Math.sign(dx) * 7},${y} C${xa + dx * .3},${y - lift} ${xb - dx * .3},${y - lift} ${xb - Math.sign(dx) * 6},${y}" fill="none" stroke="url(#${gid})" stroke-width="1.4" stroke-linecap="round"/>`
        + `<g class="echo" data-b="${A.id} ${B.id}" data-e="${e.slug}"><circle cx="${xb}" cy="${y}" r="9" fill="transparent"/><circle cx="${xb}" cy="${y}" r="6.5" fill="var(--bg)"/><circle cx="${xb}" cy="${y}" r="3.6" fill="var(--bg)" stroke="${cb}" stroke-width="1.5"/></g></g>`;
    });
  });

  s += `<g id="leaders"></g>`;
  svg.innerHTML = s;

  const todayLeft = MOBILE ? CX - 10 : 0;
  stage.insertAdjacentHTML('beforeend', `<span class="today" style="top:${Y(NOW)}px;left:${todayLeft}px">Today</span><span class="tag me" style="left:${CX}px;top:${yTip - 14}px">Pavlos</span>`);
  if (nr) {
    const about = document.createElement('a');
    about.href = '/about';
    about.className = 'ev in';
    about.dataset.about = '1';
    about.style.width = EV_W + 'px';
    about.innerHTML = '<div class="d">Roots</div><div class="t">About me</div>';
    stage.appendChild(about);
    about.style.left = MOBILE ? `${CX + GAP}px` : `${CX + 14}px`;
    about.style.top = `${rootTop - about.offsetHeight + 12}px`;
  }
  tags.forEach((t) => stage.insertAdjacentHTML('beforeend', `<span class="tag${t.dead ? ' dead' : ''}" data-b="${t.b.id}" style="left:${t.x}px;top:${t.y}px">${t.html}</span>`));

  const nodes = evs.map((v) => {
    const a = document.createElement(v.e.link ? 'a' : 'div');
    if (v.e.link) a.href = `/notes/${v.e.slug}`;
    const st = v.e.kind === 'start';
    a.className = `ev${v.dead ? ' dead' : ''}${st ? ' start' : ''}`;
    const also = (v.e.also || []).map((id) => byId[id]).filter(Boolean);
    a.dataset.b = [v.b.id, ...also.map((o) => o.id)].join(' ');
    if (also.length) a.dataset.e = v.e.slug;
    const chip = st ? '<em>started</em>' : v.e.kind === 'end' ? '<em>ended</em>' : '';
    const alsoHtml = also.length ? `<div class="also">${also.map((o) => `<span><i style="background:${o.ye ? DEAD : o.col}"></i>${esc(o.name)}</span>`).join('')}</div>` : '';
    a.innerHTML = `<div class="d">${fmt(v.e.date)}${chip}</div><div class="t">${esc(v.e.title)}</div>${alsoHtml}`;
    stage.appendChild(a);
    return { ...v, el: a, start: st };
  });

  const layoutCards = () => {
    let lead = '';
    // On mobile, resolve vertical collisions per side so dense years stay readable.
    const sidePrev = { [-1]: -1e9, [1]: -1e9 };
    branches.forEach((b) => {
      let prevBottom = -1e9;
      nodes.filter((n) => n.b === b).sort((a, c) => a.y - c.y).forEach((n) => {
        n.el.style.width = EV_W + 'px';
        const dH = n.el.querySelector('.d')?.offsetHeight || 18;
        const h = n.el.offsetHeight;
        // Center the date row on the dot. Start cards stack title above the date
        // so copy stays off the fork path below the node.
        let top = n.start ? (n.y - h + dH / 2) : (n.y - dH / 2);
        if (!n.start) top = Math.max(top, prevBottom + 14);
        if (MOBILE) top = Math.max(top, sidePrev[n.side] + 10);
        prevBottom = top + h;
        if (MOBILE) sidePrev[n.side] = top + h;
        const dateY = n.start ? top + h - dH / 2 : top + dH / 2;
        n.el.style.top = top + 'px';
        if (MOBILE) {
          // Outside the branch, toward the screen edge (option A).
          n.el.classList.toggle('r', n.side < 0);
          n.el.style.left = (n.side < 0 ? n.x - GAP - EV_W : n.x + GAP) + 'px';
          const ax = n.side < 0 ? n.x - GAP : n.x + GAP;
          if (Math.abs(dateY - n.y) > 4) lead += `<path d="M${n.x + n.side * 6},${n.y} C${ax},${n.y} ${ax},${dateY} ${ax},${dateY}" fill="none" stroke="rgba(25,24,22,.18)" stroke-width="1"/>`;
        } else {
          const ax = n.side < 0 ? n.x + GAP : n.x - GAP;
          n.el.classList.toggle('r', n.side > 0);
          n.el.style.left = (n.side < 0 ? ax : ax - EV_W) + 'px';
          if (Math.abs(dateY - n.y) > 4) lead += `<path d="M${n.x - n.side * 8},${n.y} C${ax},${n.y} ${n.x - n.side * 10},${dateY} ${ax + n.side * 2},${dateY}" fill="none" stroke="rgba(25,24,22,.18)" stroke-width="1"/>`;
        }
      });
    });
    document.getElementById('leaders').innerHTML = lead;
  };
  layoutCards();

  const hl = (ids, entry) => {
    document.body.classList.toggle('dimming', !!ids);
    document.querySelectorAll('[data-b]').forEach((x) => {
      const on = !!ids && (entry && x.classList.contains('bridge') ? x.dataset.e === entry : x.dataset.b.split(' ').some((i) => ids.includes(i)));
      x.classList.toggle('hl', on);
    });
  };
  document.querySelectorAll('.ev,.tag,.echo').forEach((x) => {
    x.addEventListener('mouseenter', () => hl(x.dataset.b.split(' '), x.dataset.e));
    x.addEventListener('mouseleave', () => hl(null));
  });

  stage.addEventListener('click', (event) => {
    const link = event.target.closest('a.ev');
    if (!link) return;
    if (link.dataset.about) {
      window.posthog?.capture('about_opened', { source: 'tree_root' });
      return;
    }
    const slug = link.getAttribute('href')?.split('/').pop();
    window.posthog?.capture('note_opened', {
      slug,
      title: link.querySelector('.t')?.textContent,
      source: 'tree',
      branch_id: link.dataset.b?.split(' ')[0],
    });
  });

  const depthMarks = [25, 50, 75, 100];
  const seenDepth = new Set();
  const trackDepth = () => {
    const doc = document.documentElement;
    const max = Math.max(1, doc.scrollHeight - innerHeight);
    const pct = Math.round((scrollY / max) * 100);
    depthMarks.forEach((mark) => {
      if (pct >= mark && !seenDepth.has(mark)) {
        seenDepth.add(mark);
        window.posthog?.capture('tree_scroll_depth', { percent: mark });
      }
    });
  };
  addEventListener('scroll', trackDepth, { passive: true });
  trackDepth();

  document.querySelectorAll('.br .stem').forEach((p) => { const L = p.getTotalLength(); p.style.strokeDasharray = L; p.style.strokeDashoffset = L; });
  let k = 1;
  const centerTrunk = () => {
    if (!MOBILE) return;
    const maxScroll = Math.max(0, wrap.scrollWidth - wrap.clientWidth);
    wrap.scrollLeft = maxScroll / 2;
  };
  const fit = () => {
    if (MOBILE) {
      k = 1;
      stage.style.transform = 'none';
      wrap.style.height = H + 'px';
      requestAnimationFrame(centerTrunk);
    } else {
      k = Math.min(1, (innerWidth - 32) / W);
      stage.style.transform = `scale(${k})`;
      wrap.style.height = H * k + 'px';
      wrap.scrollLeft = 0;
    }
  };
  fit(); addEventListener('resize', fit);

  const groups = [...document.querySelectorAll('.br')], bridgeEls = [...document.querySelectorAll('.bridge')];
  const viewing = document.getElementById('viewing'), yrEl = document.getElementById('yr'), prog = document.getElementById('prog');
  function tick() {
    const vb = scrollY + innerHeight * .92 - wrap.offsetTop;
    groups.forEach((g) => { if (!g.classList.contains('in') && +g.dataset.top * k < vb) { g.classList.add('in'); g.querySelector('.stem').style.strokeDashoffset = 0; } });
    nodes.forEach((n) => { if (!n.el.classList.contains('in') && n.y * k < vb + 40) n.el.classList.add('in'); });
    bridgeEls.forEach((g) => { if (!g.classList.contains('in') && +g.dataset.y * k < vb - 60) g.classList.add('in'); });
    const t = NOW - ((scrollY + innerHeight * .5 - wrap.offsetTop) / k - TOP) / PX;
    yrEl.textContent = Math.max(firstYear, Math.min(nowYear, Math.floor(t)));
    prog.style.height = Math.max(6, Math.min(100, (NOW - Math.min(NOW, t)) / (NOW - firstYear) * 100)) + '%';
    viewing.classList.toggle('on', scrollY + innerHeight * .5 > wrap.offsetTop);
  }
  addEventListener('scroll', tick, { passive: true });
  document.fonts.ready.then(() => { layoutCards(); tick(); });
  tick();
})();
</script>
