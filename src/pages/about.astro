---
import Base from '../layouts/Base.astro';
---

<Base title="About · Pavlos" nav="about">
  <section class="about">
    <span class="badge"><span class="live"></span>About</span>
    <h1>Hi, I'm Pavlos. <span>I design products.</span></h1>
    <div class="prose">
      <p>I'm a product designer based in Europe. I like quiet, considered software: interfaces that do less, explain themselves, and get out of the way.</p>
      <p>This site is a living timeline. Everything I spend time on grows as its own branch: the design work, the writing, the hobbies and whatever I'm curious about this month. Some branches keep growing for years. Some stop, and I leave them where they ended, because they're part of the shape too.</p>    </div>
  </section>
</Base>

<style>
  .about { max-width: 680px; margin: 0 auto; padding: 150px 24px 0; }
  h1 { font-weight: 600; font-size: 56px; line-height: 1.02; letter-spacing: -.045em; margin-top: 24px; text-wrap: balance; }
  h1 span { color: var(--soft); display: block; }
  .prose { margin-top: 36px; font-size: 17px; line-height: 1.7; color: #2E2C28; letter-spacing: -.008em; }
  .prose p + p { margin-top: 1.1em; }
  @media (max-width: 760px) {
    .about { padding-top: 120px; }
    h1 { font-size: 40px; }
  }
</style>
